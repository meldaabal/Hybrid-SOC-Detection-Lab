alert icmp 192.168.50.20 any -> 192.168.50.10 any (msg:"SOC LAB - Kali ICMP Echo Request Detected"; itype:8; sid:1000001; rev:3;)

alert tcp 192.168.50.20 any -> 192.168.50.10 any (msg:"SOC LAB - Possible TCP SYN Port Scan Detected"; flags:S; threshold:type both, track by_src, count 20, seconds 10; sid:1000002; rev:1;)

alert tcp 192.168.50.20 any -> 192.168.50.10 22 (msg:"SOC LAB - Possible SSH Service Probe Detected"; flags:S; threshold:type threshold, track by_src, count 2, seconds 5; sid:1000003; rev:3;)
